---
interface Props {
  name: 'arrow' | 'arrow-up' | 'pin' | 'instagram' | 'menu' | 'close' | 'down';
  class?: string;
}
const { name, class: className } = Astro.props;
---
<svg class={className} width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'arrow' && <path d="M4 12h15M13 5l7 7-7 7" />}
  {name === 'arrow-up' && <path d="M5 19 19 5M5 5h14v14" />}
  {name === 'down' && <path d="M12 4v16M5 13l7 7 7-7" />}
  {name === 'pin' && <><path d="M19 10c0 5-7 11-7 11S5 15 5 10a7 7 0 1 1 14 0Z" /><circle cx="12" cy="10" r="2.5" /></>}
  {name === 'instagram' && <><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".8" fill="currentColor" stroke="none" /></>}
  {name === 'menu' && <path d="M3 7h18M3 16h18" />}
  {name === 'close' && <path d="m5 5 14 14M5 19 19 5" />}
</svg>
