---
import Seo from '../components/Seo.astro';
import type { Locale } from '../data/store';
import '../styles/global.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffd21a" />
    <Seo locale={locale} />
    <link rel="icon" type="image/svg+xml" href="/hmc-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body id="top">
    <slot />
    <script>
      import { initUI } from '../scripts/ui';
      initUI();
      // Essential navigation runs independently of the animation bundle.
      void import('../scripts/motion').then(({ initMotion }) => initMotion()).catch(() => {});
    </script>
  </body>
</html>
