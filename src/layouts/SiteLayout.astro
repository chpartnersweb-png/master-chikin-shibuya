---
import { getImage } from 'astro:assets';
import ogSource from '../assets/generated/hero-chicken-desktop.png';
import { copy, store, type Locale } from '../data/store';
import '../styles/global.css';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = copy[locale];
const origin = Astro.site;
const canonical = origin ? new URL(Astro.url.pathname, origin).href : undefined;
const og = await getImage({ src: ogSource, width: 1200, format: 'webp', quality: 82 });
const ogUrl = origin ? new URL(og.src, origin).href : undefined;
const schema = {
  '@context': 'https://schema.org', '@type': 'Restaurant',
  name: store.name, alternateName: store.nameJa,
  ...(origin ? { url: origin.href } : {}),
  ...(ogUrl ? { image: ogUrl } : {}),
  description: t.description, servesCuisine: ['Halal', 'Chicken', 'Burgers'],
  address: { '@type': 'PostalAddress', streetAddress: store.streetAddress, addressLocality: '渋谷区', addressRegion: '東京都', postalCode: store.postalCode, addressCountry: 'JP' },
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'], opens: store.hours.opens, closes: store.hours.closes },
  hasMap: store.maps, sameAs: [store.instagram],
};
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#ffd21a" />
    <meta name="description" content={t.description} />
    <title>{t.title}</title>
    <link rel="icon" type="image/svg+xml" href="/hmc-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet" />
    {canonical && <link rel="canonical" href={canonical} />}
    {origin && <><link rel="alternate" hreflang="ja" href={new URL('/', origin).href} /><link rel="alternate" hreflang="en" href={new URL('/en/', origin).href} /><link rel="alternate" hreflang="x-default" href={new URL('/', origin).href} /></>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={store.name} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:locale" content={locale === 'ja' ? 'ja_JP' : 'en_US'} />
    <meta property="og:locale:alternate" content={locale === 'ja' ? 'en_US' : 'ja_JP'} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogUrl && <><meta property="og:image" content={ogUrl} /><meta property="og:image:width" content={String(og.attributes.width)} /><meta property="og:image:height" content={String(og.attributes.height)} /><meta property="og:image:alt" content={t.heroAlt} /></>}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} />
  </head>
  <body id="top">
    <slot />
    <script>
      import { initUI } from '../scripts/ui';
      initUI();
      // Essential navigation runs independently of the animation bundle.
      void import('../scripts/motion').then(({ initMotion }) => initMotion()).catch(() => {});
    </script>
  </body>
</html>
